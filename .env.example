# TradeKub API Local Environment Configuration

# Database Connection (SQLite fallback or PostgreSQL)
# Example PostgreSQL: postgresql://postgres:password@localhost:5432/tradekub
DATABASE_URL=sqlite:///./tradekub.db

# JWT Security
SECRET_KEY=local_dev_secret_key_change_in_production_1234567890
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Local Server Settings
HOST=127.0.0.1
PORT=8000

# NewsData API Integration
NEWS_DATA_API_KEY=your_newsdata_api_key_here
